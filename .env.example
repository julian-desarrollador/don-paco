# Completá estos valores en .env.local (no se commitea) y en el hosting.
# No pegues el token ni el secreto en el código.

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=

# Subida de imágenes del admin. Mismos valores en .env.local y en el hosting.
# CLOUDINARY_API_KEY y CLOUDINARY_API_SECRET son secretos.
# CLOUDINARY_CLOUD_NAME es el nombre de la nube (minúsculas), no un secreto.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
